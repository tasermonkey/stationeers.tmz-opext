<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>TmzOpExt</AssemblyName>
    <RootNamespace>TmzOpExtMod</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- The publicized game assembly needs it: the compiler then asks the runtime to skip access checks. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <StationeersDirectory Condition="'$(StationeersDirectory)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Stationeers\</StationeersDirectory>
    <Managed>$(StationeersDirectory)rocketstation_Data\Managed\</Managed>
    <!-- The game's local mods folder; the build copies the mod there. -->
    <ModDirectory Condition="'$(ModDirectory)' == ''">$([System.Environment]::GetFolderPath(SpecialFolder.MyDocuments))\My Games\Stationeers\mods\TmzOpExt\</ModDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Publicized: the opcodes subclass the chip's private operation class and use its operand classes. -->
    <Reference Include="Assembly-CSharp" Publicize="true"><HintPath>$(Managed)Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(Managed)UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Managed)UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>$(Managed)UnityEngine.AnimationModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(StationeersDirectory)BepInEx\core\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(StationeersDirectory)BepInEx\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="LaunchPadBooster"><HintPath>$(StationeersDirectory)BepInEx\plugins\StationeersLaunchPad\LaunchPadBooster.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="CopyToMods" AfterTargets="Build">
    <ItemGroup>
      <ModFiles Include="About\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ModFiles)" DestinationFiles="@(ModFiles->'$(ModDirectory)%(RelativeDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModDirectory)" SkipUnchangedFiles="true" />
    <!-- For editors: the IC10 extension for VS Code reads it from enabled mods' folders. -->
    <Copy SourceFiles="ic10-instructions.json" DestinationFolder="$(ModDirectory)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="TmzOpExt -> $(ModDirectory)" />
  </Target>
</Project>
